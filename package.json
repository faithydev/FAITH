{
  "name": "faith",
  "private": true,
  "version": "0.1.0",
  "description": "FAITH — the operating system for the next generation of digital entrepreneurship.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "pnpm --filter @faith/database migrate:deploy",
    "db:seed": "pnpm --filter @faith/database seed",
    "showcase": "pnpm --filter @faith/api seed:showcase",
    "db:reset": "node scripts/db-reset.mjs",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @faith/api dev",
    "dev:web": "pnpm --filter @faith/web dev",
    "dev:worker": "pnpm --filter @faith/worker dev",
    "build": "pnpm run build:packages && pnpm -r --filter \"./apps/*\" run build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm run build:packages && pnpm -r run typecheck",
    "test": "pnpm run test:unit && pnpm run test:api",
    "test:unit": "vitest run --project unit",
    "test:api": "node scripts/test-api.mjs",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "brand:assets": "node scripts/brand-assets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
