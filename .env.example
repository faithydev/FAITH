# FAITH local configuration. Copy to .env. `pnpm bootstrap` does this for you with generated secrets.
NODE_ENV=development

# PostgreSQL. `pnpm db:start` runs an embedded server on this port with no Docker.
DATABASE_URL=postgresql://faith:faith_dev_only@127.0.0.1:54329/faith_dev

# Redis is optional. Without it the worker polls the Postgres outbox on a timer.
# With it (docker compose up redis) the worker schedules through BullMQ.
REDIS_URL=

# URLs
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
API_PORT=4000

# Secrets. Generate your own; 32+ random bytes, base64.
APP_ENCRYPTION_KEY=
SESSION_COOKIE_SECRET=
DOWNLOAD_SIGNING_SECRET=
MOCK_PAYMENT_WEBHOOK_SECRET=

# Payments. `mock` is the development simulator and moves no real money.
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true
# Real providers stay disabled until these exist AND the adapter is verified with the provider.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage. `local` writes to .dev/storage. `s3` works with any S3-compatible endpoint.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email. `dev` records messages in the EmailOutbox table. `smtp` sends through SMTP_URL.
EMAIL_DRIVER=dev
SMTP_URL=
EMAIL_FROM=FAITH <no-reply@faith.local>

# AI. Leave ANTHROPIC_API_KEY empty to use the clearly labelled demo adapter.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# OAuth. A login button only appears when both values of a provider are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API URL the Next.js server uses for server-side requests and rewrites.
INTERNAL_API_URL=http://localhost:4000
