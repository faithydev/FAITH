{
  "name": "@faith/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "nest build && node dist/seed.js",
    "seed:showcase": "nest build && node dist/seed-showcase.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@faith/config": "workspace:*",
    "@faith/database": "workspace:*",
    "@faith/money": "workspace:*",
    "@faith/validators": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.0",
    "otplib": "13.6.0",
    "pino": "10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7",
    "@faith/automation": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0",
    "@faith/sdk": "workspace:*"
  }
}
